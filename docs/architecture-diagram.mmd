---
title: AI Work Estimation and Pricing Assistant -- MVP.M1-M3 (Current State)
---
flowchart TD
    User["Nontechnical business user"]

    subgraph UI["UI layer -- app.py (Streamlit, single-page wizard + persistent sidebar)"]
        Wizard["5-step wizard\n(work type, quick facts, scope checklist,\ncomplexity and AI, review and estimate)"]
        Sidebar["Persistent sidebar\n(step status, current estimate,\nrunning estimate, warnings)"]
        Actions["Action navigation\n(Preliminary SOW Outline, Build Resource Plan --\nactive; Final SOW / Excel / PowerPoint -- locked)"]
    end

    subgraph Helpers["Non-authoritative UI-support helpers -- src/"]
        ScopeDefaults["scope_defaults.py\nscope defaults + confirmation %"]
        AssumptionEngine["assumption_engine.py\ntemplate-based assumptions"]
        RunningPreview["running_estimate_preview.py\n\"Preliminary\" partial-complexity view"]
        SowOutline["sow_outline_engine.py\nResponsible-AI-style gate +\npreliminary SOW outline builder"]
    end

    subgraph Models["src/models.py"]
        EstimateRequest["EstimateRequest\n(assembled at Review step)"]
        ResourcePlanResult["ResourcePlanResult\n(phases/roles/hours, no cost)"]
        BaselineCostResult["BaselineCostResult\n(role cost, blended rate,\nreadiness status -- no margin/price)"]
    end

    subgraph Engines["Authoritative engine layer -- src/"]
        ComplexityEngine["complexity_engine.py\nweighted score + contributions\n(unchanged since MVP.M1)"]
        SizingEngine["sizing_engine.py\nRJS / T-shirt / sprint range\n(unchanged since MVP.M1)"]
        ContractFit["contract_fit.py\ncontract-fit status\n(unchanged since MVP.M1)"]
        PhasePlanner["phase_planner.py\nphases + durations\n(unchanged since MVP.M2)"]
        ResourcePlanner["resource_planner.py\nroles, person-sprints, hours,\nstaffing views, warnings\n(unchanged since MVP.M2)"]
        PricingEngine["pricing_engine.py (MVP.M3)\nrole cost, baseline delivery cost,\nblended rate, readiness status"]
    end

    subgraph Config["Configuration -- data/ (governed JSON + CSV)"]
        Weights["complexity_weights.json"]
        Questions["complexity_questions.json"]
        Bands["sizing_bands.json"]
        Terms["contract_terms.json"]
        ScopeConfig["scope_checklist_items.json"]
        AssumptionConfig["assumption_templates.json"]
        PhaseRules["phase_rules.json"]
        ResourceRules["resource_rules.json"]
        RoleCombos["role_combinations.json"]
        RateCard["rate_card.csv\n(illustrative/fictional rates only)"]
        SowTemplates["sow_outline_templates.json"]
    end

    HumanReview["Human review point\n(Review step -- Step 5,\nrequired before calculation runs)"]
    ReadinessReview["Human review point\n(pricing-readiness status:\nBlocked > Human Review > Ready)"]

    subgraph FutureScope["Not implemented -- deferred"]
        CommercialPricing["Commercial pricing: contingency,\nmargin, gross profit, customer price\n(MVP.M4)"]
        SupportEstimation["Support estimation\n(MVP.M5)"]
        FinalSow["Governed final SOW, Excel/PowerPoint\nexport (MVP.M6)"]
        AIAdapter["Estimator's own AI-assisted intake\n(MVP.M7, replaceable interface)"]
    end

    User -->|answers wizard steps 1-4| Wizard
    Wizard <-->|reads defaults, writes corrections| ScopeDefaults
    ScopeDefaults -->|reads| ScopeConfig
    Wizard -->|answered-so-far scores| RunningPreview
    RunningPreview -->|reuses, does not modify| SizingEngine
    RunningPreview -->|"Preliminary" size/duration| Sidebar
    ScopeDefaults -->|scope-confirmation %| Sidebar

    Wizard -->|confirms inputs| HumanReview
    HumanReview -->|selections + unknown items| AssumptionEngine
    AssumptionEngine -->|reads| AssumptionConfig
    AssumptionEngine -->|editable assumptions| Wizard
    HumanReview -->|assembles| EstimateRequest
    EstimateRequest --> ComplexityEngine
    ComplexityEngine -->|reads| Weights
    ComplexityEngine -->|reads| Questions
    ComplexityEngine -->|unrounded score| SizingEngine
    SizingEngine -->|reads| Bands
    SizingEngine -->|max sprint estimate| ContractFit
    ContractFit -->|reads| Terms
    ContractFit -->|governed results| Sidebar
    ContractFit -->|governed results| Wizard
    Wizard --> Actions

    Actions -->|"Build Resource Plan"| PhasePlanner
    PhasePlanner -->|reads| PhaseRules
    PhasePlanner -->|phases| ResourcePlanner
    ResourcePlanner -->|reads| ResourceRules
    ResourcePlanner -->|reads| RoleCombos
    ResourcePlanner --> ResourcePlanResult
    ResourcePlanResult -->|editable table + totals| Actions

    ResourcePlanResult -->|role hours| PricingEngine
    PricingEngine -->|reads| RateCard
    PricingEngine --> BaselineCostResult
    BaselineCostResult -->|editable scenario-rate table\n+ totals + warnings| Actions
    BaselineCostResult --> ReadinessReview

    Actions -->|"Generate Preliminary SOW Outline"| SowOutline
    SowOutline -->|reads| SowTemplates
    EstimateRequest --> SowOutline
    ResourcePlanResult -->|phases/roles/hours only| SowOutline
    BaselineCostResult -.->|boolean status signal only,\nnever an amount| SowOutline
    SowOutline -->|"Preliminary Draft" outline| Actions
    Actions -->|displays| User

    Wizard -.->|not built yet| CommercialPricing
    BaselineCostResult -.->|feeds MVP.M4| CommercialPricing
    CommercialPricing -.->|not built yet| SupportEstimation
    SupportEstimation -.->|not built yet| FinalSow
    Wizard -.->|not built yet| AIAdapter

    classDef future stroke-dasharray: 5 5,opacity:0.6;
    class CommercialPricing,SupportEstimation,FinalSow,AIAdapter future;
